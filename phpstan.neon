
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - packages

    level: 5

    ignoreErrors:
        # Publishable config templates, copied into config/ by vendor:publish, where env() is expected.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - packages/Webkul/Agent/src/Config/agent.php
                - packages/Webkul/Core/src/Config/cors.php
                - packages/Webkul/Gourwest/src/Config/gourwest.php
                - packages/Webkul/Ledger/src/Config/ledger.php
                - packages/Webkul/Security/src/Config/security.php
                - packages/Webkul/Tma/src/Config/tma.php

    bootstrapFiles:
        - vendor/autoload.php

    excludePaths:
        analyse:
            - vendor
            - storage
            - bootstrap/cache
            # Unused legacy base class; its astrotomic/laravel-translatable dependency is not installed.
            - packages/Webkul/Core/src/Eloquent/TranslatableModel.php
