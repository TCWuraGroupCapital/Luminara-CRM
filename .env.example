APP_NAME="Luminara CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=USD
# Host port Docker Compose publishes the CRM on (http://127.0.0.1:APP_PORT). Change it if
# 8080 is taken.
APP_PORT=8080

# First administrator for `php artisan luminara:provision` (or pass --admin-email/--admin-password).
# The password must be at least 12 characters. Never commit real values.
LUMINARA_ADMIN_EMAIL=
LUMINARA_ADMIN_PASSWORD=

VITE_HOST=
VITE_PORT=

CORS_ALLOWED_ORIGINS=
# Comma-separated reverse-proxy / Cloudflare Tunnel IPs or CIDRs (compose.prod.yaml pre-populates Cloudflare + 172.31.250.0/28).
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Supported: mysql, mariadb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-crm
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@luminaracrm.local
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=luminaracrm.local
MAIL_VERIFY_PEER=true

SECURITY_REQUIRE_ADMIN_MFA=false
SECURITY_MAX_FAILED_LOGINS_PER_EMAIL=10
# Cloudflare Tunnel connector token, used only by the cloudflared service in compose.prod.yaml.
CLOUDFLARE_TUNNEL_TOKEN=

# Logical backup encryption (optional). 32 bytes, standard base64, separate from APP_KEY.
# Generate: php artisan luminara:backup-key
# The manifest stores only the key id. Keep the key in a password manager. See docs/backups.md.
# Empty leaves backups as plain gzip NDJSON, which verify and restore still accept.
LUMINARA_BACKUP_KEY=

# Off-site backups: the backup-sync service in compose.prod.yaml (`--profile offsite`) copies
# storage/app to any S3-compatible bucket, encrypted first. Use a key limited to that one bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypt files before upload. Keep both (and APP_KEY) in a password manager: without them the
# off-site copy cannot be read. Generate each with: openssl rand -base64 32
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=
# Optional heartbeat URL from your uptime monitor, pinged after every successful off-site sync.
BACKUP_HEARTBEAT_URL=

MAIL_RECEIVER_DRIVER=sendgrid
# Shared secret your inbound-parse webhook (e.g. SendGrid) must send; inbound mail is rejected while empty.
MAIL_RECEIVER_INBOUND_TOKEN=

# Only needed when MAIL_RECEIVER_DRIVER=webklex-imap. Use your own mailbox credentials.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

# Optional S3 storage. Leave empty to keep files on the local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Optional Google OAuth app for Google Contacts sync (Webkul\GoogleContact). Create your own in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30

# Only needed when NOTIFICATION_DRIVER=reverb (or pusher below). Generate your own app credentials.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# In-app Assistant and the Desk's "Ask the agent" (Webkul\Agent).
# Leave the key empty to let admins enter their own under Settings > Configuration >
# AI Assistant (or to keep the Assistant off). A key here wins, and then the model and
# base URL below are used too. CRM records the signed-in person can read are sent to
# this service to answer their requests.
LUMINARA_ASSISTANT_API_KEY=
LUMINARA_ASSISTANT_MODEL=claude-opus-5-5
# Optional: another Anthropic Messages-compatible endpoint.
LUMINARA_ASSISTANT_BASE_URL=

# Durable, human-approved customer facts for agents. Off by default.
LUMINARA_AGENT_MEMORY=false

# Workspaces (Webkul\Workspace): one separate database per business. Off by default.
# The database user needs: GRANT ALL ON `<DB_DATABASE>\_ws\_%`.* TO it.
LUMINARA_WORKSPACES=false
# Public sign-up page at /signup: off, invite (needs the code below) or open.
LUMINARA_SIGNUP=off
LUMINARA_SIGNUP_INVITE_CODE=
# Require new owners to open an emailed link before their workspace is built (true/false).
# Empty = on for open sign-up, off for invite. Needs working outgoing mail (not MAIL_MAILER=log).
LUMINARA_SIGNUP_VERIFY_EMAIL=
LUMINARA_WORKSPACE_LIMIT=50

# Legal pages (Webkul\Legal): /terms, /privacy, /legal/dpa and /legal/subprocessors, read from your
# own Markdown files in storage/app/legal (terms.md, privacy.md, dpa.md, subprocessors.md).
# Off by default; when on and terms.md exists, sign-up requires accepting them and records it.
LUMINARA_LEGAL_PAGES=false
# Label for the current texts, shown on each page and stored with every acceptance (e.g. 2026-12-01).
LUMINARA_LEGAL_VERSION=

# Single sign-on (Webkul\Sso): shows "Sign in with single sign-on". Each business then enters its
# OpenID Connect provider under Settings > Configuration. See docs/sso-google-workspace.md.
LUMINARA_SSO=false
# Only for a local test provider (e.g. Keycloak in Docker): allow http and private addresses.
LUMINARA_SSO_ALLOW_PRIVATE_ISSUERS=false

# Verifiable Data Blocks & Merkle Ledger (Webkul\Ledger).
# Optional 64-hex Ed25519 seed (falls back to HKDF-SHA256 derived from APP_KEY).
LUMINARA_LEDGER_SEED=
# Anchor driver: local (default) or ton (Webkul\Tma).
LEDGER_ANCHOR_DRIVER=local

# Telegram Mini App & Bot Intake Webhook (Webkul\Tma). Optional. Each value set here wins over
# Settings > Configuration > Telegram; leave all empty to configure it there or keep it off.
# Create your own bot with @BotFather; never reuse someone else's token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram echoes back on each webhook call (setWebhook secret_token).
TELEGRAM_WEBHOOK_SECRET=
# Only for LEDGER_ANCHOR_DRIVER=ton: your relayer endpoint and contract address.
TON_ANCHOR_RELAYER_URL=
TON_ANCHOR_CONTRACT=

# Webkul\Gourwest demo hub: shared HMAC secret for its integration webhook. Optional.
GOURWEST_WEBHOOK_SECRET=
